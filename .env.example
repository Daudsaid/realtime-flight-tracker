# OpenSky API credentials (opensky-network.org → Account → API Client)
OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here

# Optional: write to a hosted Postgres (e.g. Neon) so the Streamlit Cloud
# dashboard can read it. Leave unset to use the local Docker Postgres.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Optional: hours of history to keep in flight_positions (0 = forever).
# HISTORY_RETENTION_HOURS=24
